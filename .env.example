# Copier en .env puis renseigner les valeurs. Ne JAMAIS commiter le fichier .env.
APP_ENV=local

# Base MongoDB (docker compose) — en local hors Docker : MONGO_URI=mongodb://127.0.0.1:27017/exam1Db
MONGO_ROOT_USER=exam1
MONGO_ROOT_PASSWORD=change-me
MONGO_URI=mongodb://127.0.0.1:27017/exam1Db

# Backend
PORT=5000
JWT_SECRET=generer-avec-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000
GATEWAY_URL=http://localhost:8000
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Clé partagée backend -> gateway -> microservices (openssl rand -hex 32)
INTERNAL_API_KEY=change-me

# Gateway
GATEWAY_PORT=8000
NOTIFI_SERVICE_URL=http://localhost:4002
STOCK_SERVICE_URL=http://localhost:4003

# Microservice notifications (SMTP Gmail, mot de passe d'application)
EMAIL_USER=
EMAIL_APPLICATION_PASSWORD=
