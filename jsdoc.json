{
  "source": {
    "include": ["backend", "gateway", "microservices"],
    "includePattern": ".js$",
    "excludePattern": "(node_modules|.test.js$)"
  },
  "opts": {
    "destination": "docs/api",
    "recurse": true,
    "readme": "README.md",
    "encoding": "utf8"
  },
  "templates": {
    "cleverLinks": true,
    "default": {
      "outputSourceFiles": true
    }
  }
}
